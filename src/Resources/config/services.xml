<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Daten -->
        <service id="Nova\Search\Service\SearchStatistics">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Nova\Search\Service\RewriteStore">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Nova\Search\Service\PopularSearches">
            <argument type="service" id="Nova\Search\Service\SearchStatistics"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Nova\Search\Service\EventRecorder">
            <argument type="service" id="Nova\Search\Service\SearchStatistics"/>
            <argument type="service" id="Nova\Search\Service\RewriteStore"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Nova\Search\Service\NumberIndex">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Nova\Search\Subscriber\NumberIndexSubscriber">
            <argument type="service" id="Nova\Search\Service\NumberIndex"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Nova\Search\Command\NumberIndexCommand">
            <argument type="service" id="Nova\Search\Service\NumberIndex"/>
            <tag name="console.command"/>
        </service>

        <service id="Nova\Search\Service\HighlightProvider">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="cache.object"/>
        </service>

        <service id="Nova\Search\Rules\RuleStore">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="cache.object"/>
        </service>

        <service id="Nova\Search\Rules\SearchRules">
            <argument type="service" id="Nova\Search\Rules\RuleStore"/>
        </service>

        <!-- Synonyme -->
        <service id="Nova\Search\Search\SynonymTermInterpreter"
                 decorates="Shopware\Core\Content\Product\SearchKeyword\ProductSearchTermInterpreter">
            <argument type="service" id="Nova\Search\Search\SynonymTermInterpreter.inner"/>
            <argument type="service" id="Nova\Search\Rules\SearchRules"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Nova\Search\Subscriber\SearchRedirectSubscriber">
            <argument type="service" id="Nova\Search\Rules\SearchRules"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Nova\Search\Service\RequestBudget">
            <argument type="service" id="cache.object"/>
        </service>

        <!-- Suche: Umschreibungen anwenden und gelernte Produkte boosten -->
        <service id="Nova\Search\Search\LearningProductSearchBuilder"
                 decorates="Shopware\Core\Content\Product\SearchKeyword\ProductSearchBuilderInterface">
            <argument type="service" id="Nova\Search\Search\LearningProductSearchBuilder.inner"/>
            <argument type="service" id="Nova\Search\Service\RewriteStore"/>
            <argument type="service" id="Nova\Search\Service\SearchStatistics"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Nova\Search\Service\NumberIndex"/>
        </service>

        <!-- Claude -->
        <service id="Nova\Search\Service\ClaudeUsage">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Nova\Search\Rewrite\ClaudeBudget">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Nova\Search\Service\ClaudeUsage"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Nova\Search\Rewrite\ClaudeRewriteSuggester">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Nova\Search\Rewrite\ClaudeBudget"/>
        </service>

        <service id="Nova\Search\Command\ClaudeUsageCommand">
            <argument type="service" id="Nova\Search\Rewrite\ClaudeBudget"/>
            <argument type="service" id="Nova\Search\Service\ClaudeUsage"/>
            <tag name="console.command"/>
        </service>

        <service id="Nova\Search\Rewrite\RewriteSuggesterInterface" alias="Nova\Search\Rewrite\ClaudeRewriteSuggester"/>

        <service id="Nova\Search\Rewrite\RewriteService">
            <argument type="service" id="Nova\Search\Service\RewriteStore"/>
            <argument type="service" id="Nova\Search\Rewrite\RewriteSuggesterInterface"/>
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Search\ProductSearchRoute"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
        </service>

        <!-- Hintergrund -->
        <service id="Nova\Search\ScheduledTask\SearchLearningTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="Nova\Search\ScheduledTask\SearchLearningTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Nova\Search\Rewrite\RewriteService"/>
            <argument type="service" id="Nova\Search\Service\SearchStatistics"/>
            <argument type="service" id="Nova\Search\Service\NumberIndex"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="Nova\Search\Service\SearchExport">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Nova\Search\Service\StatsImport">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Nova\Search\Command\ImportStatsCommand">
            <argument type="service" id="Nova\Search\Service\StatsImport"/>
            <tag name="console.command"/>
        </service>

        <service id="Nova\Search\Command\ExportCommand">
            <argument type="service" id="Nova\Search\Service\SearchExport"/>
            <tag name="console.command"/>
        </service>

        <service id="Nova\Search\Command\RewriteCommand">
            <argument type="service" id="Nova\Search\Rewrite\RewriteService"/>
            <tag name="console.command"/>
        </service>

        <!-- Ereignisse -->
        <service id="Nova\Search\Subscriber\SearchPageSubscriber">
            <argument type="service" id="Nova\Search\Service\SearchStatistics"/>
            <argument type="service" id="Nova\Search\Service\RewriteStore"/>
            <argument type="service" id="Nova\Search\Rewrite\RewriteService"/>
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Search\ProductSearchRoute"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Nova\Search\Subscriber\OrderAttributionSubscriber">
            <argument type="service" id="Nova\Search\Service\SearchStatistics"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Nova\Search\Cookie\CookieListener">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="kernel.event_listener" event="Shopware\Core\Content\Cookie\Event\CookieGroupCollectEvent"/>
        </service>

        <!-- Administration: Auswertung -->
        <service id="Nova\Search\Service\SearchAnalytics">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Nova\Search\Controller\AdminAnalyticsController" public="true">
            <argument type="service" id="Nova\Search\Service\SearchAnalytics"/>
            <argument type="service" id="Nova\Search\Service\SearchExport"/>
            <argument type="service" id="Nova\Search\Rewrite\ClaudeBudget"/>
            <argument type="service" id="Nova\Search\Service\StatsImport"/>
            <argument type="service" id="logger"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Nova\Search\Controller\AdminRulesController" public="true">
            <argument type="service" id="Nova\Search\Rules\RuleStore"/>
            <argument type="service" id="logger"/>
            <tag name="controller.service_arguments"/>
        </service>

        <!-- Storefront -->
        <service id="Nova\Search\Service\PartnerSearch">
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Search\ProductSearchRoute"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Nova\Search\Controller\InstantSearchController" public="true">
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Search\ProductSearchRoute"/>
            <argument type="service" id="sales_channel.category.repository"/>
            <argument type="service" id="sales_channel.product.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Nova\Search\Service\PopularSearches"/>
            <argument type="service" id="Nova\Search\Rules\SearchRules"/>
            <argument type="service" id="Nova\Search\Service\HighlightProvider"/>
            <argument type="service" id="Nova\Search\Service\PartnerSearch"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Nova\Search\Controller\PartRequestController" public="true">
            <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="cache.object"/>
            <argument type="service" id="logger"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Nova\Search\Controller\TrackingController" public="true">
            <argument type="service" id="Nova\Search\Service\EventRecorder"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <!-- Store-API für Apps -->
        <service id="Nova\Search\StoreApi\NovaSearchRoute" public="true">
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Search\ProductSearchRoute"/>
            <argument type="service" id="Nova\Search\Service\RewriteStore"/>
            <argument type="service" id="Nova\Search\Rules\SearchRules"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Nova\Search\StoreApi\NovaPopularRoute" public="true">
            <argument type="service" id="Nova\Search\Service\PopularSearches"/>
        </service>

        <service id="Nova\Search\StoreApi\NovaTrackRoute" public="true">
            <argument type="service" id="Nova\Search\Service\EventRecorder"/>
            <argument type="service" id="Nova\Search\Service\RequestBudget"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>
    </services>
</container>
