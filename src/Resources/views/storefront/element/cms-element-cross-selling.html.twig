{% sw_extends '@Storefront/storefront/element/cms-element-cross-selling.html.twig' %}

{# „Kunden kauften auch“ (Nova Suche) als eigene Zeile unter den Cross-Selling-Reitern #}
{% block cms_element_cross_selling_tabs_inner %}
    {{ parent() }}

    {% set novaAlsoBought = element.extensions.novaAlsoBought|default(null) %}
    {% if novaAlsoBought and novaAlsoBought.total > 0 %}
        {% block nova_search_also_bought %}
            {% set novaSliderConfig = sliderConfig|default(null) ?: element.fieldConfig.elements %}
            <div class="product-detail-cross-selling nova-also-bought">
                {% sw_include '@Storefront/storefront/element/cms-element-product-slider.html.twig' with {
                    sliderConfig: {
                        title: { value: novaAlsoBought.crossSelling.translated.name ?: novaAlsoBought.crossSelling.name },
                        border: { value: false },
                        rotate: { value: false },
                        products: { value: novaAlsoBought.products },
                        boxLayout: { value: novaSliderConfig.boxLayout.value|default('standard') },
                        elMinWidth: { value: novaSliderConfig.elMinWidth.value|default('300px') },
                        navigation: { value: true },
                        navigationArrows: { value: 'outside' },
                        displayMode: { value: novaSliderConfig.displayMode.value|default('standard') },
                        verticalAlign: { value: 'center' },
                        speed: { value: novaSliderConfig.speed.value|default(300) },
                    },
                    element: {
                        data: { products: novaAlsoBought.products },
                        type: 'product-slider',
                    },
                } %}
            </div>
        {% endblock %}
    {% endif %}
{% endblock %}
