{# Trefferansicht des Suchfensters #}
{% block nova_search_results %}
    {# „rewritten“ auch bei Weiterleitung: dann wird der Begriff nicht für Claude vorgemerkt #}
    <div class="nova-search-results" data-nova-search-total="{{ total }}"{% if rewrite or redirect|default(null) %} data-nova-search-rewritten="1"{% endif %}>
        {% if redirect|default(null) %}
            {% block nova_search_redirect %}
                <a class="nova-search-redirect nova-search-focusable" href="{{ redirect }}" data-nova-search-redirect>
                    <span class="nova-search-redirect-label">{{ 'novaSearch.redirectHint'|trans({ '%term%': term }) }}</span>
                    <span class="nova-search-redirect-arrow" aria-hidden="true">→</span>
                </a>
            {% endblock %}
        {% endif %}
        {% if hints|default([])|length > 0 %}
            {% block nova_search_hints %}
                {% for hint in hints %}
                    {% if hint.url %}
                        <a class="nova-search-hint nova-search-focusable" href="{{ hint.url }}"{% if hint.external|default(false) %} target="_blank" rel="noopener"{% endif %}>
                            <span>{{ hint.text }}</span>
                            <span class="nova-search-redirect-arrow" aria-hidden="true">→</span>
                        </a>
                    {% else %}
                        <p class="nova-search-hint">{{ hint.text }}</p>
                    {% endif %}
                {% endfor %}
            {% endblock %}
        {% endif %}
        {% if redirect|default(null) and total == 0 and filterCount == 0 %}
            {# Weiterleitung statt „Keine Treffer“ – der Link oben ist das Ergebnis #}
        {% elseif total == 0 and categories|length == 0 and filterCount == 0 %}
            {% block nova_search_empty %}
                <div class="nova-search-empty">
                    {% if exactNumber|default(false) %}
                        <p class="nova-search-empty-title">{{ 'novaSearch.exactNoResults'|trans({ '%term%': term }) }}</p>
                        <p class="nova-search-empty-hint">{{ 'novaSearch.exactNoResultsHint'|trans }}</p>
                    {% else %}
                        <p class="nova-search-empty-title">{{ 'novaSearch.noResults'|trans({ '%term%': term }) }}</p>
                        {% if noResultsText|default('') %}
                            <div class="nova-search-empty-text">{{ noResultsText|sw_sanitize }}</div>
                        {% else %}
                            <p class="nova-search-empty-hint">{{ 'novaSearch.noResultsHint'|trans }}</p>
                        {% endif %}
                    {% endif %}

                    {# „Teil anfragen“: Formular im Suchfenster und/oder Link zum Kontaktformular #}
                    {% set novaContactUrl = null %}
                    {% if requestPartUrl|default(null) %}
                        {% set novaContactUrl = requestPartUrl ~ ('?' in requestPartUrl ? '&' : '?')
                            ~ 'nova-anfrage=' ~ ('novaSearch.requestPartMessage'|trans({ '%term%': term })|striptags|url_encode)
                            ~ '&nova-betreff=' ~ ('novaSearch.requestPartSubject'|trans|striptags|url_encode) %}
                    {% endif %}
                    {% if requestPartForm|default(false) %}
                        {% block nova_search_request_form %}
                            <details class="nova-search-request">
                                <summary class="btn btn-primary nova-search-focusable">{{ 'novaSearch.requestPart'|trans }}</summary>
                                <form class="nova-search-request-form" action="{{ path('frontend.nova-search.request') }}" method="post" data-nova-search-request data-error-text="{{ 'novaSearch.requestError'|trans|striptags }}" novalidate>
                                    <p class="nova-search-request-intro">{{ 'novaSearch.requestIntro'|trans }}</p>
                                    <input type="hidden" name="term" value="{{ term }}">
                                    {# Für Menschen unsichtbar – Bots füllen es aus #}
                                    <div class="nova-search-request-hp" aria-hidden="true">
                                        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
                                    </div>
                                    <label class="nova-search-request-field is-wide">
                                        <span>{{ 'novaSearch.requestMessage'|trans }}</span>
                                        <textarea name="message" rows="2" maxlength="1000" class="form-control">{{ 'novaSearch.requestPartMessage'|trans({ '%term%': term })|striptags }}</textarea>
                                    </label>
                                    <label class="nova-search-request-field">
                                        <span>{{ 'novaSearch.requestEmail'|trans }}</span>
                                        <input type="email" name="email" maxlength="200" autocomplete="email" class="form-control">
                                    </label>
                                    <label class="nova-search-request-field">
                                        <span>{{ 'novaSearch.requestPhone'|trans }}</span>
                                        <input type="tel" name="phone" maxlength="40" autocomplete="tel" class="form-control">
                                    </label>
                                    <label class="nova-search-request-field is-wide">
                                        <span>{{ 'novaSearch.requestName'|trans }} <small>({{ 'novaSearch.requestOptional'|trans }})</small></span>
                                        <input type="text" name="name" maxlength="100" autocomplete="name" class="form-control">
                                    </label>
                                    <p class="nova-search-request-note is-wide">{{ 'novaSearch.requestContactHint'|trans }}</p>
                                    {% set novaPrivacyOpen = '<button type="button" class="btn btn-link-inline" data-ajax-modal="true" data-url="' ~ path('frontend.cms.page', { id: config('core.basicInformation.privacyPage') }) ~ '">' %}
                                    <div class="nova-search-request-privacy is-wide">
                                        {% if config('core.loginRegistration.requireDataProtectionCheckbox') == 1 %}
                                            <label class="form-check">
                                                <input type="checkbox" name="acceptedDataProtection" value="1" class="form-check-input" required>
                                                <span class="form-check-label">{{ 'contact.privacyNoticeTextModal'|trans({ '%privacyModalTagOpen%': novaPrivacyOpen, '%privacyModalTagClose%': '</button>' })|raw }}</span>
                                            </label>
                                        {% else %}
                                            {{ 'contact.privacyNoticeInformation'|trans({ '%privacyModalTagOpen%': novaPrivacyOpen, '%privacyModalTagClose%': '</button>' })|raw }}
                                        {% endif %}
                                    </div>
                                    <div class="nova-search-request-actions is-wide">
                                        <button type="submit" class="btn btn-primary">{{ 'novaSearch.requestSend'|trans }}</button>
                                        {% if novaContactUrl %}
                                            <a href="{{ novaContactUrl }}" class="nova-search-request-contact">{{ 'novaSearch.requestContactLink'|trans }}</a>
                                        {% endif %}
                                    </div>
                                    <p class="nova-search-request-status is-wide" role="status" aria-live="polite" data-nova-search-request-status></p>
                                </form>
                            </details>
                        {% endblock %}
                    {% elseif novaContactUrl %}
                        {% block nova_search_request_part %}
                            <a class="btn btn-primary nova-search-request-part nova-search-focusable" href="{{ novaContactUrl }}">
                                {{ 'novaSearch.requestPart'|trans }}
                            </a>
                        {% endblock %}
                    {% endif %}
                </div>

                {% sw_include '@NovaSearch/storefront/nova-search/partners.html.twig' %}

                {% if recommendations|default([])|length > 0 %}
                    {% block nova_search_empty_recommendations %}
                        <section class="nova-search-highlights nova-search-recommendations">
                            <h2 class="nova-search-title">{{ 'novaSearch.recommendations'|trans }}</h2>
                            <div class="nova-search-slider">
                                <button type="button" class="nova-search-slider-btn is-prev" data-nova-search-slide="-1" aria-label="{{ 'novaSearch.previous'|trans|striptags }}">
                                    {% sw_icon 'arrow-head-left' %}
                                </button>
                                <ul class="nova-search-slider-track list-unstyled" data-nova-list-id="search_no_results" data-nova-list-name="Suche: Empfehlungen ohne Treffer">
                                    {% for product in recommendations %}
                                        {% sw_include '@NovaSearch/storefront/nova-search/card.html.twig' with { product: product } %}
                                    {% endfor %}
                                </ul>
                                <button type="button" class="nova-search-slider-btn is-next" data-nova-search-slide="1" aria-label="{{ 'novaSearch.next'|trans|striptags }}">
                                    {% sw_icon 'arrow-head-right' %}
                                </button>
                            </div>
                        </section>
                    {% endblock %}
                {% endif %}
            {% endblock %}
        {% else %}
            {% set novaProperties = properties|default([]) %}
            <div class="nova-search-layout{% if manufacturers|length == 0 and not priceRange and novaProperties|length == 0 %} no-filters{% endif %}">
                {% if manufacturers|length > 0 or priceRange or novaProperties|length > 0 %}
                    {% block nova_search_filters %}
                        <aside class="nova-search-filters" id="nova-search-filters">
                            {% if manufacturers|length > 0 %}
                                <section class="nova-search-facet">
                                    <h2 class="nova-search-facet-title">{{ 'novaSearch.manufacturers'|trans }}</h2>
                                    <ul class="list-unstyled nova-search-facet-list{% if manufacturers|length > 8 %} is-collapsed{% endif %}">
                                        {% for manufacturer in manufacturers %}
                                            <li>
                                                <label class="nova-search-check">
                                                    <input type="checkbox" class="form-check-input nova-search-focusable"
                                                           value="{{ manufacturer.id }}"
                                                           data-nova-search-manufacturer
                                                           {% if manufacturer.active %}checked{% endif %}>
                                                    <span class="nova-search-check-label">{{ manufacturer.name }}</span>
                                                    <span class="nova-search-check-count">{{ manufacturer.count }}</span>
                                                </label>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                    {% if manufacturers|length > 8 %}
                                        <button type="button" class="nova-search-more" data-nova-search-expand>{{ 'novaSearch.showMore'|trans }}</button>
                                    {% endif %}
                                </section>
                            {% endif %}

                            {% for group in novaProperties %}
                                {% block nova_search_property_facet %}
                                    <section class="nova-search-facet">
                                        <h2 class="nova-search-facet-title">{{ group.name }}</h2>
                                        <ul class="list-unstyled nova-search-facet-list{% if group.options|length > 8 %} is-collapsed{% endif %}">
                                            {% for option in group.options %}
                                                <li>
                                                    <label class="nova-search-check">
                                                        <input type="checkbox" class="form-check-input nova-search-focusable"
                                                               value="{{ option.id }}"
                                                               data-nova-search-property
                                                               {% if option.active %}checked{% endif %}>
                                                        <span class="nova-search-check-label">{{ option.name }}</span>
                                                    </label>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                        {% if group.options|length > 8 %}
                                            <button type="button" class="nova-search-more" data-nova-search-expand>{{ 'novaSearch.showMore'|trans }}</button>
                                        {% endif %}
                                    </section>
                                {% endblock %}
                            {% endfor %}

                            {% if priceRange and priceRange.max > priceRange.min %}
                                <section class="nova-search-facet">
                                    <h2 class="nova-search-facet-title">{{ 'novaSearch.price'|trans }}</h2>
                                    <div class="nova-search-range" data-nova-search-price data-min="{{ priceRange.min }}" data-max="{{ priceRange.max }}">
                                        <div class="nova-search-range-slider">
                                            <input type="range" min="{{ priceRange.min }}" max="{{ priceRange.max }}" step="1"
                                                   value="{{ priceRange.from ?? priceRange.min }}" data-nova-search-range="from"
                                                   aria-label="{{ 'novaSearch.priceFrom'|trans|striptags }}">
                                            <input type="range" min="{{ priceRange.min }}" max="{{ priceRange.max }}" step="1"
                                                   value="{{ priceRange.to ?? priceRange.max }}" data-nova-search-range="to"
                                                   aria-label="{{ 'novaSearch.priceTo'|trans|striptags }}">
                                        </div>
                                        <div class="nova-search-range-inputs">
                                            <label class="nova-search-range-field">
                                                <span class="visually-hidden">{{ 'novaSearch.priceFrom'|trans }}</span>
                                                <input type="number" inputmode="numeric" class="form-control" min="{{ priceRange.min }}" max="{{ priceRange.max }}"
                                                       value="{{ priceRange.from ?? priceRange.min }}" data-nova-search-price-input="from">
                                                <span>{{ context.currency.symbol }}</span>
                                            </label>
                                            <label class="nova-search-range-field">
                                                <span class="visually-hidden">{{ 'novaSearch.priceTo'|trans }}</span>
                                                <input type="number" inputmode="numeric" class="form-control" min="{{ priceRange.min }}" max="{{ priceRange.max }}"
                                                       value="{{ priceRange.to ?? priceRange.max }}" data-nova-search-price-input="to">
                                                <span>{{ context.currency.symbol }}</span>
                                            </label>
                                        </div>
                                    </div>
                                </section>
                            {% endif %}

                            {% if filterCount > 0 %}
                                <button type="button" class="nova-search-reset" data-nova-search-reset>{{ 'novaSearch.resetFilters'|trans }}</button>
                            {% endif %}
                        </aside>
                    {% endblock %}
                {% endif %}

                {% block nova_search_main %}
                    <div class="nova-search-main">
                        {# Zum eingegebenen Begriff gab es hier nichts – Treffer aus Schwestershops zuerst #}
                        {% sw_include '@NovaSearch/storefront/nova-search/partners.html.twig' %}

                        {# Hinweis zur Umschreibung direkt über den eigenen (umgeschriebenen) Treffern #}
                        {% if rewrite %}
                            {% block nova_search_rewrite_hint %}
                                <p class="nova-search-rewrite">
                                    {{ (partners|default([])|length > 0 ? 'novaSearch.rewriteHintPartner' : 'novaSearch.rewriteHint')|trans({ '%rewrite%': rewrite.rewrite, '%original%': rewrite.original }) }}
                                </p>
                            {% endblock %}
                        {% endif %}

                        <div class="nova-search-meta">
                            <p class="nova-search-count" role="status">
                                {{ 'novaSearch.count'|trans({ '%count%': total })|raw }}
                            </p>

                            {% if manufacturers|length > 0 or priceRange %}
                                <button type="button" class="nova-search-filter-toggle" aria-controls="nova-search-filters" aria-expanded="false" data-nova-search-filter-toggle>
                                    {% sw_icon 'filter' style { size: 'sm' } %}
                                    {{ 'novaSearch.filter'|trans }}{% if filterCount > 0 %} ({{ filterCount }}){% endif %}
                                </button>
                            {% endif %}

                            {% if sortings and sortings|length > 1 and total > 1 %}
                                <label class="nova-search-sort">
                                    <span>{{ 'novaSearch.sortBy'|trans }}</span>
                                    <select class="form-select form-select-sm" data-nova-search-sort>
                                        {% for sorting in sortings %}
                                            <option value="{{ sorting.key }}"{% if sorting.key == currentSorting %} selected{% endif %}>{{ sorting.translated.label }}</option>
                                        {% endfor %}
                                    </select>
                                </label>
                            {% endif %}
                        </div>

                        {% if categories|length > 0 %}
                            <div class="nova-search-categories">
                                {% for category in categories %}
                                    {% set path = category.breadcrumb|slice(1, -1) %}
                                    <a class="nova-search-category nova-search-focusable" href="{{ category_url(category) }}">
                                        <span class="nova-search-hl">{{ category.translated.name }}</span>
                                        {% if path|length > 0 %}<small>{{ path|last }}</small>{% endif %}
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {% if total > 0 %}
                            <ul class="nova-search-grid list-unstyled" data-nova-search-grid data-nova-list-id="search_window" data-nova-list-name="Suchfenster" data-nova-search-has-more="{{ hasMore ? '1' : '0' }}">
                                {% for product in products %}
                                    {% sw_include '@NovaSearch/storefront/nova-search/card.html.twig' with { product: product } %}
                                {% endfor %}
                            </ul>

                            {% if hasMore %}
                                <div class="nova-search-loadmore" data-nova-search-sentinel>
                                    <button type="button" class="btn btn-outline-primary" data-nova-search-loadmore>{{ 'novaSearch.loadMore'|trans }}</button>
                                </div>
                            {% endif %}
                        {% else %}
                            <p class="nova-search-hint">{{ 'novaSearch.noProducts'|trans }}</p>
                        {% endif %}
                    </div>
                {% endblock %}
            </div>
        {% endif %}

        {# Rückmeldung zum Suchergebnis – auch bei 0 Treffern, nicht bei einer reinen Weiterleitung #}
        {% if not (redirect|default(null) and total == 0 and filterCount == 0) %}
            {% sw_include '@NovaSearch/storefront/nova-search/feedback.html.twig' with { novaFeedbackTerm: term, novaFeedbackSource: 'layer' } %}
        {% endif %}
    </div>
{% endblock %}
