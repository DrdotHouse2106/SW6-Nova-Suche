{#
 # Rückmeldung zum Suchergebnis: „Gefällt Ihnen das Suchergebnis?“ mit Daumen hoch / Daumen runter,
 # nach „Daumen runter“ optional ein kurzer Text. Variablen: novaFeedbackTerm, novaFeedbackSource (layer|page).
 # Logik: app/storefront/src/plugin/nova-search-feedback.js
 #}
{% block nova_search_feedback %}
    {% if config('NovaSearch.config.feedbackActive') is not same as(false) and novaFeedbackTerm|default('')|trim != '' %}
        {% set novaFeedbackId = 'nova-search-feedback-' ~ novaFeedbackSource %}
        <div class="nova-search-feedback"
             data-nova-search-feedback
             data-url="{{ path('frontend.nova-search.feedback') }}"
             data-term="{{ novaFeedbackTerm }}"
             data-source="{{ novaFeedbackSource }}">
            <div class="nova-search-feedback-ask" role="group" aria-labelledby="{{ novaFeedbackId }}-question" data-nova-search-feedback-ask>
                <span class="nova-search-feedback-question" id="{{ novaFeedbackId }}-question">{{ 'novaSearch.feedback.question'|trans|striptags }}</span>
                <button type="button" class="nova-search-feedback-btn nova-search-focusable" data-nova-search-feedback-rating="up"
                        aria-label="{{ 'novaSearch.feedback.up'|trans|striptags }}" title="{{ 'novaSearch.feedback.up'|trans|striptags }}">
                    {% sw_icon 'thumb-up' style { size: 'sm' } %}
                </button>
                <button type="button" class="nova-search-feedback-btn nova-search-focusable" data-nova-search-feedback-rating="down"
                        aria-label="{{ 'novaSearch.feedback.down'|trans|striptags }}" title="{{ 'novaSearch.feedback.down'|trans|striptags }}">
                    {% sw_icon 'thumb-down' style { size: 'sm' } %}
                </button>
            </div>
            <form class="nova-search-feedback-form" data-nova-search-feedback-form hidden novalidate>
                <label class="nova-search-feedback-label" for="{{ novaFeedbackId }}-text">{{ 'novaSearch.feedback.textLabel'|trans|striptags }}</label>
                <div class="nova-search-feedback-row">
                    <input type="text" id="{{ novaFeedbackId }}-text" name="text" maxlength="200" autocomplete="off"
                           class="form-control form-control-sm" placeholder="{{ 'novaSearch.feedback.textPlaceholder'|trans|striptags }}">
                    <button type="submit" class="btn btn-sm btn-primary">{{ 'novaSearch.feedback.send'|trans|striptags }}</button>
                </div>
            </form>
            <p class="nova-search-feedback-thanks" role="status" aria-live="polite" data-nova-search-feedback-status
               data-thanks="{{ 'novaSearch.feedback.thanks'|trans|striptags }}"></p>
        </div>
    {% endif %}
{% endblock %}
